#include<stdio.h>
int main()
{
int a[100],i,n,k,j,temp;
printf("enter size of array)"
scanf("%d",&n);
printf("enter array element ");
for(i=0;i<n;i++)
scanf("%d",&a[i]);
printf("enter k");
scanf("%d",&k);
k=k%n;
for(i=0;i<k;i++)
{
  temp=a[n-1];
  for(j=n-1;j>0;j--)
    a[j]=a[j-1];
  a[0]=temp;
}
printf("rotated array");
for(i=0;i<n;i++)
  printf("%d",a[i]);
return 0;
}
